    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@expo/eas-json": "24.5.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
