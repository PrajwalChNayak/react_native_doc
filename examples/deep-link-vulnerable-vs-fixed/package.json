    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.0",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.14",
    "@types/react": "19.1.1",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "typescript": "5.9.3"
  }
