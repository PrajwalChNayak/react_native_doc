# EXPO_PUBLIC_* variables are INLINED INTO THE BUNDLE at build time.
# They are a build-time text substitution, not a runtime secret.
# The two below are deliberately fake, and scripts/prove-leak.mjs finds both
# inside the exported Hermes bytecode.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_ANALYTICS_KEY=pk_live_NOT_A_REAL_KEY_6f2b9c1d4e

# NOT prefixed with EXPO_PUBLIC_, so it is NOT inlined and NOT readable in the
# bundle. It is also not available to client code at runtime — which is the
# entire point. A real server-side secret lives here or, better, never touches
# the client build at all.
SERVER_ONLY_SECRET=sk_live_NOT_A_REAL_SECRET_a1b2c3d4e5
