{
  "name": "react-native-device-metadata",
  "version": "0.1.0",
  "private": true,
  "description": "Example TurboModule library for React Native 0.87: a Codegen spec plus Kotlin and Swift implementations.",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "android/src",
    "android/build.gradle",
    "ios",
    "RNDeviceMetadata.podspec",
    "react-native.config.js",
    "!**/build",
    "!**/__tests__"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >= 26.0.0"
  },
  "keywords": [
    "react-native",
    "turbomodule",
    "codegen"
  ],
  "codegenConfig": {
    "name": "RNDeviceMetadataSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.devicemetadata"
    },
    "ios": {
      "modulesProvider": {
        "DeviceMetadata": "RNDeviceMetadata"
      }
    }
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1"
  },
  "devDependencies": {
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "19.1.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "typescript": "5.9.3"
  }
}
